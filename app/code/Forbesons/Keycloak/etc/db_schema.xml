<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="forbesons_keycloak_identity" resource="default" engine="innodb" comment="Forbesons Keycloak Customer Identity">
        <column xsi:type="int" name="identity_id" unsigned="true" nullable="false" identity="true" comment="Identity ID"/>
        <column xsi:type="varchar" name="keycloak_sub" nullable="false" length="255" comment="Keycloak Subject"/>
        <column xsi:type="int" name="customer_id" unsigned="true" nullable="false" comment="Customer ID"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="identity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="FORBESONS_KEYCLOAK_IDENTITY_SUB">
            <column name="keycloak_sub"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="FORBESONS_KEYCLOAK_IDENTITY_CUSTOMER">
            <column name="customer_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="FORBESONS_KEYCLOAK_IDENTITY_CUSTOMER_FK" table="forbesons_keycloak_identity" column="customer_id" referenceTable="customer_entity" referenceColumn="entity_id" onDelete="CASCADE"/>
    </table>
</schema>